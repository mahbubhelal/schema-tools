{
    "name": "mahbubhelal/schema-tools",
    "description": "Laravel Artisan commands and a Rector rule that keep SQL Server and MySQL schema fixtures, Eloquent models and model factories in agreement with the live source databases.",
    "type": "library",
    "keywords": [
        "laravel",
        "sqlsrv",
        "sql-server",
        "mysql",
        "mariadb",
        "schema",
        "fixtures",
        "eloquent",
        "factories",
        "testing",
        "migrations"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Md Mahbub Helal",
            "email": "mdhelal00@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.35",
        "illuminate/container": "^13.35",
        "illuminate/contracts": "^13.35",
        "illuminate/database": "^13.35",
        "illuminate/support": "^13.35",
        "nikic/php-parser": "^5.0",
        "rector/rector": "^2.8",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/phpstan-strict-rules": "^2.1"
    },
    "suggest": {
        "mahbubhelal/refresh-databases": "Loads the <connection>-schema.sql, -views.sql and -seed.sql fixtures this package maintains into the test databases (FastRefreshDatabases)."
    },
    "autoload": {
        "psr-4": {
            "Mahbub\\SchemaTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mahbub\\SchemaTools\\Tests\\": "tests"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mahbub\\SchemaTools\\SchemaToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
