{
    "name": "mahbubhelal/schema-tools",
    "description": "Laravel Artisan commands that keep SQL Server and MySQL schema fixtures, Eloquent models and model factories in agreement with the live source databases.",
    "type": "library",
    "keywords": [
        "laravel",
        "sqlsrv",
        "sql-server",
        "mysql",
        "mariadb",
        "schema",
        "fixtures",
        "eloquent",
        "factories",
        "testing",
        "migrations"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mahbub Helal",
            "email": "mdhelal00@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "symfony/finder": "^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.5 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "mahbubhelal/refresh-databases": "Loads the <connection>-schema.sql, -views.sql and -seed.sql fixtures this package maintains into the test databases (FastRefreshDatabases)."
    },
    "autoload": {
        "psr-4": {
            "Mahbub\\SchemaTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mahbub\\SchemaTools\\Tests\\": "tests"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mahbub\\SchemaTools\\SchemaToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "coverage": "pest --coverage --bail",
        "format": "pint",
        "refactor": "rector",
        "test": "pest --bail",
        "types": "phpstan --memory-limit=1024M",
        "all": [
            "@refactor",
            "@format",
            "@types",
            "@test"
        ],
        "check": [
            "@refactor --dry-run",
            "@format --test",
            "@types",
            "@coverage --min=100"
        ]
    }
}
